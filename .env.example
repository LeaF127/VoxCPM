# VoxCPM S2ST API 配置文件
#
# 使用说明：
# 1. 复制本文件为 .env: cp .env.example .env (Linux/Mac) 或 copy .env.example .env (Windows)
# 2. 修改下面的配置项
# 3. .env 文件会被 .gitignore 忽略，不会被提交到版本控制

# ============================================
# ASR WebSocket 服务配置（必填）
# ============================================
# ASR WebSocket 服务地址
WS_URL=ws://your-asr-server:port/ws

# 用户 ID
USER_ID=your_user_id

# 认证 Token
TOKEN=your_token

# ============================================
# 语言配置
# ============================================
# 源语言代码（zh=中文, en=英文）
FROM_LANG=zh

# 目标语言代码（zh=中文, en=英文）
TO_LANG=en

# ============================================
# TTS 配置
# ============================================
# TTS 文本来源：trans=使用翻译结果, asr=使用识别结果
TTS_TEXT_SOURCE=trans

# VoxCPM CFG 值（控制语音相似度，建议范围 1.0-5.0）
CFG_VALUE=2.0

# VoxCPM 推扩散步数（建议范围 5-25，步数越多质量越好但速度越慢）
INFERENCE_TIMESTEPS=10

# ============================================
# 模型配置
# ============================================
# VoxCPM 模型路径（相对或绝对路径）
# 如果使用本地模型，填写模型目录路径
# 如果使用 HuggingFace 模型，可以留空，设置 VOXCPM_HF_ID
VOXCPM_MODEL_PATH=./models/openbmb__VoxCPM-0.5B/

# HuggingFace 模型 ID（可选，当本地没有模型时会从此下载）
VOXCPM_HF_ID=openbmb/VoxCPM-0.5B

# 模型缓存目录（可选）
VOXCPM_CACHE_DIR=

# 仅使用本地文件（不联网下载 HuggingFace 模型）
# true=仅使用本地文件, false=允许从 HuggingFace 下载
VOXCPM_LOCAL_FILES_ONLY=false

# 禁用降噪器（加速模型加载，可能影响音质）
# true=禁用降噪器, false=启用降噪器
VOXCPM_NO_DENOISER=false

# 禁用模型优化（加速模型加载，可能影响性能）
# true=禁用优化, false=启用优化
VOXCPM_NO_OPTIMIZE=false

# ============================================
# API 服务配置
# ============================================
# API 服务监听地址
API_HOST=0.0.0.0

# API 服务端口
API_PORT=19366

# 日志级别（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO

# ============================================
# 音频处理配置
# ============================================
# 音频采样率（Hz）
AUDIO_SAMPLE_RATE=16000

# 音频位深度（bit）
AUDIO_BIT_RATE=16

# ============================================
# 路径配置
# ============================================
# 输出目录（音频文件保存位置）
OUTPUT_DIR=s2st_demo/output

# 临时文件目录
TEMP_DIR=s2st_demo/output/temp

# 静态文件 URL 前缀
STATIC_URL_PREFIX=/static

# ============================================
# 前端配置
# ============================================
# 前端服务端口
FRONTEND_PORT=8080
